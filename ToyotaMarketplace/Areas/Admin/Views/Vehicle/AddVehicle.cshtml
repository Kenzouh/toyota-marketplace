@{
	Layout = "_Layout";
}

<h1>Add Vehicle Page</h1>	

@{
    Layout = "_Layout";
}

<div class="min-h-screen bg-zinc-100 py-10">

    <div class="mx-auto max-w-7xl px-6">

        <!-- PAGE HEADER -->
        <div class="mb-8">

            <div class="flex items-center gap-4">

                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-black shadow-lg">

                    <img src="~/icons/car.svg"
                         alt="vehicle"
                         class="h-7 w-7 invert" />

                </div>

                <div>

                    <h1 class="text-4xl font-black tracking-tight text-zinc-900">
                        Add Vehicle
                    </h1>

                    <p class="mt-1 text-zinc-500">
                        Create and manage complete vehicle specifications and features.
                    </p>

                </div>

            </div>

        </div>

        <form method="post"
              enctype="multipart/form-data"
              class="space-y-8">

            <!-- ================================================== Vehicle Hero Section ================================================== -->

            <section class="overflow-hidden rounded-[2rem] bg-white shadow-xl">

                <div class="border-b border-zinc-200 bg-black px-8 py-6">

                    <h2 class="text-3xl font-black text-white">
                        Vehicle Hero Section
                    </h2>

                    <p class="mt-2 text-sm text-zinc-300">
                        Main vehicle identity, branding, pricing, and appearance.
                    </p>

                </div>

                <div class="grid gap-6 p-8 lg:grid-cols-2">

                    <!-- Vehicle Image -->
                    <div class="space-y-2">
                        
                        <!-- VehicleImg -->
                        <label class="text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Vehicle Images
                        </label>

                        <div class="rounded-2xl border-2 border-dashed border-zinc-300 bg-zinc-50 p-8 text-center transition hover:border-red-500 hover:bg-red-50">

                            <input type="file"
                                   multiple
                                   class="w-full text-sm text-zinc-600" />

                            <p class="mt-3 text-sm text-zinc-400">
                                Upload multiple vehicle images
                            </p>

                        </div>

                    </div>

                    <!-- Right Side -->
                    <div class="grid gap-5">

                        <div>

                            <!-- VehicleName -->
                            <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                                Vehicle Name
                            </label>

                            <input type="text"
                                   placeholder="Toyota Vios"
                                   class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none transition focus:border-red-500 focus:ring-4 focus:ring-red-100" />

                        </div>

                        <!-- Vehicle Type -->
                        <div class="grid gap-5 md:grid-cols-2">

                            <div>

                                <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                                    Vehicle Type
                                </label>

                                <!-- VehicleType: retrieved from DB, and displayed -->
                                <select class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none transition focus:border-red-500 focus:ring-4 focus:ring-red-100">

                                    <option>Select Vehicle Type</option>
                                    <option>Gazoo Racing</option>
                                    <option>SUV</option>
                                    <option>Sedan</option>

                                </select>

                            </div>

                            <div>

                                <!-- PowerTrainType -->
                                <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                                    PowerTrain
                                </label>

                                <select class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none transition focus:border-red-500 focus:ring-4 focus:ring-red-100">

                                    <option>Select PowerTrain</option>
                                    <option>Gas</option>
                                    <option>Electric</option>
                                    <option>Hybrid</option>

                                </select>

                                <div>

                                    <!-- FuelName -->
                                    <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                                        Fuel Type
                                    </label>

                                    <select class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none transition focus:border-red-500 focus:ring-4 focus:ring-red-100">

                                        <option>Select Fuel Type</option>
                                        <option>Gasoline</option>
                                        <option>Diesel</option>
                                        <option>Premium</option>

                                    </select>

                                </div>

                            </div>

                        </div>

                        <!-- Wheels + SRP -->
                        <div class="grid gap-5 md:grid-cols-2">

                            <div>

                                <!-- Wheel -->
                                <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                                    Wheels
                                </label>

                                <input type="number"
                                       placeholder="4"
                                       class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none transition focus:border-red-500 focus:ring-4 focus:ring-red-100" />

                            </div>

                            <div>


                                <!-- VehicleSRP -->
                                <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                                    SRP
                                </label>

                                <input type="number"
                                       step="0.01"
                                       placeholder="1250000"
                                       class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none transition focus:border-red-500 focus:ring-4 focus:ring-red-100" />

                            </div>

                        </div>

                    </div>

                    <!-- Colors -->
                    <div class="lg:col-span-2">

                        <label class="mb-3 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Available Colors
                        </label>

                        <div class="flex items-center rounded-2xl border border-zinc-200 bg-zinc-50 overflow-hidden">

                            <!-- Left Arrow -->
                            <button type="button"
                                    class="flex h-16 w-16 items-center justify-center border-r border-zinc-200 text-2xl font-black text-zinc-500 transition hover:bg-zinc-100 hover:text-black">

                                ‹

                            </button>

                            <!-- Color Circles -->
                            <div class="flex flex-1 items-center gap-4 overflow-x-auto px-6 py-4">

                                <!-- Black -->
                                <button type="button"
                                        class="group relative h-12 w-12 rounded-full border-4 border-white bg-black shadow-lg transition hover:scale-125">

                                    <span class="absolute inset-0 flex items-center justify-center text-white opacity-0 transition group-hover:opacity-100">

                                        ✓

                                    </span>

                                </button>

                                <!-- White -->
                                <button type="button"
                                        class="group relative h-12 w-12 rounded-full border border-zinc-300 bg-white shadow-lg transition hover:scale-125">

                                    <span class="absolute inset-0 flex items-center justify-center text-black opacity-0 transition group-hover:opacity-100">

                                        ✓

                                    </span>

                                </button>

                                <!-- Red -->
                                <button type="button"
                                        class="group relative h-12 w-12 rounded-full bg-red-500 shadow-lg transition hover:scale-125">

                                    <span class="absolute inset-0 flex items-center justify-center text-white opacity-0 transition group-hover:opacity-100">

                                        ✓

                                    </span>

                                </button>

                                <!-- Blue -->
                                <button type="button"
                                        class="group relative h-12 w-12 rounded-full bg-blue-500 shadow-lg transition hover:scale-125">

                                    <span class="absolute inset-0 flex items-center justify-center text-white opacity-0 transition group-hover:opacity-100">

                                        ✓

                                    </span>

                                </button>

                            </div>

                            <!-- Hexadecimal -->
                            <div class="flex h-16 items-center border-l border-zinc-200 px-6">

                                <span class="font-mono text-sm font-bold text-zinc-700">
                                    #000000
                                </span>

                            </div>

                            <!-- Plus Button -->
                            <div class="border-l border-zinc-200">

                                <button type="button"
                                        class="flex h-16 w-16 items-center justify-center text-3xl font-light text-zinc-500 transition hover:bg-red-50 hover:text-red-600">

                                    +

                                </button>

                            </div>

                            <!-- Right Arrow -->
                            <button type="button"
                                    class="flex h-16 w-16 items-center justify-center border-l border-zinc-200 text-2xl font-black text-zinc-500 transition hover:bg-zinc-100 hover:text-black">

                                ›

                            </button>

                        </div>

                    </div>

                    <!-- Disclaimer -->
                    <div class="lg:col-span-2">

                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Disclaimer
                        </label>

                        <textarea rows="4"
                                  placeholder="Actual unit specifications may vary depending on region and model variant."
                                  class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none transition focus:border-red-500 focus:ring-4 focus:ring-red-100"></textarea>

                    </div>

                </div>

            </section>



            <!-- ================================================== Performance ================================================== -->

            <section class="overflow-hidden rounded-[2rem] bg-white shadow-xl">

                <div class="border-b border-zinc-200 bg-black px-8 py-6">

                    <h2 class="text-3xl font-black text-white">
                        Performance
                    </h2>

                </div>

                <div class="grid gap-5 p-8 md:grid-cols-2">


                    <!-- Engine -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Engine
                        </label>

                        <input type="text"
                               class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />
                    </div>

                    <!-- TransmissionName -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Transmission
                        </label>

                        <select class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100">

                            <option>Select Transmission</option>
                            <option>CVT</option>
                            <option>Automatic</option>
                            <option>Manual</option>

                        </select>
                    </div>

                    <!-- Drivetrain -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Drivetrain
                        </label>

                        <input type="text"
                               class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />
                    </div>

                    <!-- Chassis -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Chassis
                        </label>

                        <input type="text"
                               class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />
                    </div>

                    <!-- ModeName -->
                    <div class="md:col-span-2">

                        <label class="mb-3 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Drive Modes
                        </label>

                        <div class="flex flex-wrap gap-4 rounded-2xl border border-zinc-200 bg-zinc-50 p-5">

                            <label class="flex items-center gap-2">
                                <input type="checkbox" />
                                <span>Eco</span>
                            </label>

                            <label class="flex items-center gap-2">
                                <input type="checkbox" />
                                <span>Normal</span>
                            </label>

                            <label class="flex items-center gap-2">
                                <input type="checkbox" />
                                <span>Sport</span>
                            </label>

                            <label class="flex items-center gap-2">
                                <input type="checkbox" />
                                <span>EV</span>
                            </label>

                        </div>

                    </div>

                </div>

            </section>



            <!-- ================================================== Technical Specifications ================================================== -->

            <section class="overflow-hidden rounded-[2rem] bg-white shadow-xl">

                <div class="border-b border-zinc-200 bg-black px-8 py-6">

                    <h2 class="text-3xl font-black text-white">
                        Technical Specifications
                    </h2>

                </div>

                <div class="grid gap-5 p-8 md:grid-cols-2">

                    <!-- Suspension -->
                    <input type="text" placeholder="Suspension" class="rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />

                    <!-- SteeringSystemName -->
                    <input type="text" placeholder="Steering System Name" class="rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />

                    <!-- SteeringTypeName -->
                    <input type="text" placeholder="Steering Type Name" class="rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />

                    <!-- PowerSteeringTypeName -->
                    <select class="rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100">

                        <option>Power Steering Type</option>
                        <option>Electronic</option>
                        <option>Hydraulic</option>

                    </select>

                    <!-- FrontBrake -->
                    <input type="text" placeholder="Front Brake" class="rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />

                    <!-- RearBrake -->
                    <input type="text" placeholder="Rear Brake" class="rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />

                    <!-- MinimumTurningRadius -->
                    <input type="number" placeholder="Minimum Turning Radius" class="rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />

                    <!-- BatteryName -->
                    <select class="rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100">

                        <option>Battery Type</option>
                        <option>Lithium Iron</option>
                        <option>Nickel Metal</option>

                    </select>

                </div>

            </section>



            <!-- ================================================== Dimensions & Capacity ================================================== -->

            <section class="overflow-hidden rounded-[2rem] bg-white shadow-xl">

                <div class="border-b border-zinc-200 bg-black px-8 py-6">

                    <h2 class="text-3xl font-black text-white">
                        Dimensions & Capacity
                    </h2>

                </div>

                <div class="grid gap-5 p-8 md:grid-cols-3">

                    <!-- DimensionX -->
                    <div>

                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Width
                        </label>

                        <input type="number"
                               class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />

                    </div>

                    <!-- DimensionY-->
                    <div>

                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Height
                        </label>

                        <input type="number"
                               class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />

                    </div>

                    <!-- DimensionZ -->
                    <div>

                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Length
                        </label>

                        <input type="number"
                               class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />

                    </div>

                    <!-- GroundClearance -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Ground Clearance
                        </label>

                        <input type="number"
                            step="0.01"
                            placeholder="198.50"
                            class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />
                    </div>

                    <!-- SeatingCapacity -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Seating Capacity
                        </label>

                        <input type="number" 
                            step="0.01"
                            placeholder="7.00"
                            class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100"
                            />
                    </div>

                    <!-- PayloadCapacity -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Payload Capacity
                        </label>

                        <input type="number"
                            step="0.01"
                            placeholder="7.00"
                            class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100"  />
                    </div>

                </div>

            </section>



            <!-- ================================================== Exterior Features ================================================== -->

            <section class="overflow-hidden rounded-[2rem] bg-white shadow-xl">

                <div class="border-b border-zinc-200 bg-black px-8 py-6">

                    <h2 class="text-3xl font-black text-white">
                        Exterior Features
                    </h2>

                </div>

                <div class="grid gap-5 p-8">

                    <!-- Exterior -->
                    <textarea rows="4"
                              placeholder="Exterior Features"
                              class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100"></textarea>

                    <!-- TireDiskWheel -->
                    <textarea rows="4"
                              placeholder="Tire & Disk Wheel"
                              class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100"></textarea>

                </div>

            </section>



            <!-- ================================================== Interior Features ================================================== -->

            <section class="overflow-hidden rounded-[2rem] bg-white shadow-xl">

                <div class="border-b border-zinc-200 bg-black px-8 py-6">

                    <h2 class="text-3xl font-black text-white">
                        Interior Features
                    </h2>

                </div>

                <div class="grid gap-5 p-8 md:grid-cols-2">

                    <!-- Interior -->
                    <textarea rows="3" placeholder="Interior" class="rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100"></textarea>

                    <!-- MeterCluster -->
                    <textarea rows="3" placeholder="Meter Cluster" class="rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100"></textarea>

                    <!-- MultiInfoDisplay -->
                    <textarea rows="3" placeholder="Multi Info Display" class="rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100"></textarea>

                    <!-- Audio -->
                    <textarea rows="3" placeholder="Audio" class="rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100"></textarea>

                    <!-- Ignition -->
                    <textarea rows="3" placeholder="Ignition" class="rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100"></textarea>

                    <!-- Function -->
                    <textarea rows="3" placeholder="Function" class="rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100"></textarea>

                </div>

            </section>



            <!-- ================================================== Safety Features ================================================== -->

            <section class="overflow-hidden rounded-[2rem] bg-white shadow-xl">

                <div class="border-b border-zinc-200 bg-black px-8 py-6">

                    <h2 class="text-3xl font-black text-white">
                        Safety Features
                    </h2>

                </div>

                <div class="grid gap-5 p-8">

                    <!-- Safety -->
                    <textarea rows="4"
                              placeholder="Safety Features"
                              class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100"></textarea>

                    <!-- AntiLockBrakeSystem -->
                    <textarea rows="4"
                              placeholder="Anti-lock Brake System"
                              class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100"></textarea>

                </div>

            </section>



            <!-- ================================================== Additional Information ================================================== -->

            <section class="overflow-hidden rounded-[2rem] bg-white shadow-xl">

                <div class="border-b border-zinc-200 bg-black px-8 py-6">

                    <h2 class="text-3xl font-black text-white">
                        Additional Information
                    </h2>

                </div>

                <div class="grid gap-5 p-8">

                    <!-- ModelNote -->
                    <textarea rows="4"
                              placeholder="ModelNote"
                              class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100"></textarea>

                    <!-- Auto Date Posted -->
                    <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">

                        <p class="text-sm uppercase tracking-wide text-zinc-400">
                            Date Posted
                        </p>

                        <h3 class="mt-2 text-lg font-bold text-zinc-900">
                            Automatically Generated
                        </h3>

                    </div>

                </div>

            </section>



            <!-- Submit -->
            <div class="sticky bottom-6 z-50 flex justify-end">

                <button type="submit"
                        class="rounded-2xl bg-red-600 px-8 py-4 text-lg font-bold text-white shadow-2xl transition hover:scale-105 hover:bg-red-700">

                    Save Vehicle

                </button>

            </div>

        </form>

    </div>

</div>