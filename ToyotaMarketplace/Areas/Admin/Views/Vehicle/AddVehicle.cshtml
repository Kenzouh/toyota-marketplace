@model ToyotaMarketplace.Models.ViewModels.Admin.Vehicle.AddVehicleViewModel

@using System.Text.Json

@{
	Layout = "_Layout";
}

<div class="min-h-screen bg-zinc-100 py-10">

    <div class="mx-auto max-w-7xl px-6">

        <!-- PAGE HEADER -->
        <div class="mb-8">

            <div class="flex items-center gap-4">

                <div class="flex h-14 w-14 items-center justify-center rounded-2xl bg-black shadow-lg">

                    <img src="~/icons/car.svg"
                         alt="vehicle"
                         class="h-7 w-7 invert" />

                </div>

                <div>

                    <h1 class="text-4xl font-black tracking-tight text-zinc-900">
                        Add Vehicle
                    </h1>

                    <p class="mt-1 text-zinc-500">
                        Create and manage complete vehicle specifications and features.
                    </p>

                </div>

            </div>

        </div>

        <form method="post"
              enctype="multipart/form-data"
              class="space-y-8">

              @Html.AntiForgeryToken()

            <!-- ================================================== Vehicle Hero Section ================================================== -->

            <section class="overflow-hidden rounded-[2rem] bg-white shadow-xl">

                <div class="border-b border-zinc-200 bg-black px-8 py-6">

                    <h2 class="text-3xl font-black text-white">
                        Vehicle Hero Section
                    </h2>

                    <p class="mt-2 text-sm text-zinc-300">
                        Main vehicle identity, branding, pricing, and appearance.
                    </p>

                </div>

                <div class="grid gap-6 p-8 lg:grid-cols-2">

                    <!-- Vehicle Image -->
                    <div class="space-y-2">
                        
                        <!-- VehicleImg -->
                        <label class="text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Vehicle Images
                        </label>

                        <div class="rounded-2xl border-2 border-dashed border-zinc-300 bg-zinc-50 p-8 text-center transition hover:border-red-500 hover:bg-red-50">

                            <input asp-for="VehicleImages",
                                   type="file"
                                   multiple
                                   class="w-full text-sm text-zinc-600" />

                            <p class="mt-3 text-sm text-zinc-400">
                                Upload a vehicle image
                            </p>

                        </div> 

                    </div>

                    <!-- Right Side -->
                    <div class="grid gap-5">

                        <div>

                            <!-- VehicleName -->
                            <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                                Vehicle Name <span class="text-red-500 text-sm">*</span>
                            </label>
                            

                            <input asp-for="VehicleName",
                                   type="text"
                                   placeholder="Toyota Vios"
                                   class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none transition focus:border-red-500 focus:ring-4 focus:ring-red-100" />

                            <span asp-validation-for="VehicleName" class="text-red-500 text-sm"></span>
                        </div>

                        <!-- Vehicle Type -->
                        <div class="grid gap-5 md:grid-cols-2">

                            <div>

                                <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                                    Vehicle Type
                                </label>

                                <!-- VehicleType: retrieved from DB, and displayed -->
                                <select id="vehicleTypeDropdown"
                                        asp-for="VehicleTypeId"
                                        asp-items="Model.VehicleTypes"
                                        class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none transition focus:border-red-500 focus:ring-4 focus:ring-red-100">

                                    <option value="">
                                        Select Vehicle Type
                                    </option>

                                </select>

                                <span asp-validation-for="VehicleTypeId" class="text-red-500 text-sm"></span>

                                <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                                    Vehicle Model
                                </label>

                                <!-- VehicleModel: retrieved from DB and displayed -->
                                <select id="vehicleModelDropdown"
                                        asp-for="VehicleModelId"
                                        asp-items="Model.VehicleModels"
                                        class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none transition focus:border-red-500 focus:ring-4 focus:ring-red-100">

                                    <option value="">
                                        Select Vehicle Model
                                    </option>

                                </select>

                                <span asp-validation-for="VehicleModelId" class="text-red-500 text-sm"></span>
                            </div>

                            <div>

                                <!-- PowerTrainType -->
                                <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                                    PowerTrain
                                </label>

                                <select asp-for="PowerTrainId"
                                        asp-items="Model.PowerTrains"
                                        class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none transition focus:border-red-500 focus:ring-4 focus:ring-red-100">

                                    <option value="">
                                        Select PowerTrain
                                    </option>

                                </select>

                                <span asp-validation-for="PowerTrainId" class="text-red-500 text-sm"></span>

                                <div>

                                    <!-- FuelName -->
                                    <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                                        Fuel Type
                                    </label>

                                    <select asp-for="FuelTypeId"
                                            asp-items="Model.FuelTypes"
                                            class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none transition focus:border-red-500 focus:ring-4 focus:ring-red-100">

                                        <option value="">Select Fuel Type</option>

                                    </select>


                                </div>

                            </div>

                        </div>

                        <!-- Wheels + SRP -->
                        <div class="grid gap-5 md:grid-cols-2">

                            <div>

                                <!-- Wheel -->
                                <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                                    Wheels
                                </label>

                                <input asp-for="Wheel"
                                       type="number"
                                       placeholder="4"
                                       class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none transition focus:border-red-500 focus:ring-4 focus:ring-red-100" />

                            </div>

                            <div>


                                <!-- VehicleSRP -->
                                <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                                    SRP
                                </label>

                                <input asp-for="VehicleSRP"
                                       type="number"
                                       step="0.01"
                                       placeholder="1250000"
                                       class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none transition focus:border-red-500 focus:ring-4 focus:ring-red-100" />

                            </div>

                        </div>

                    </div>

                    <!-- Colors -->
                    <div class="lg:col-span-2">

                        <label class="mb-3 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Available Colors
                        </label>

                        <div class="overflow-hidden rounded-2xl border border-zinc-200 bg-zinc-50">

                            <!-- TOP SECTION -->
                            <div class="flex flex-wrap items-center justify-between gap-4 border-b border-zinc-200 bg-white px-6 py-4">

                                <!-- LEFT -->
                                <div class="flex items-center gap-4">

                                    <!-- VehicleColorCategory -->
                                    <div>

                                        <label class="mb-2 block text-xs font-bold uppercase tracking-wide text-zinc-400">
                                            Color Category
                                        </label>

                                        <select id="colorCategoryDropdown"
                                                class="rounded-xl border border-zinc-300 bg-zinc-50 px-4 py-2 text-sm font-medium outline-none transition focus:border-red-500 focus:ring-4 focus:ring-red-100">

                                            <option value="">
                                                Select Category
                                            </option>

                                            @foreach (var category in Model.VehicleColorCategories)
                                            {
                                                <option value="@category.Value">
                                                    @category.Text
                                                </option>
                                            }

                                        </select>

                                    </div>

                                </div>

                                <!-- RIGHT -->
                                <div class="text-right">

                                    <!-- VehicleColorName -->
                                    <p id="selectedColorName"
                                       class="text-xs font-bold uppercase tracking-wide text-zinc-400">

                                        No Color Selected

                                    </p>

                                    <!-- Divider -->
                                    <div class="my-2 h-px w-full bg-zinc-200"></div>

                                    <!-- VehicleColorHexadecimal -->
                                    <p id="selectedColorHex"
                                       class="font-mono text-lg font-black text-zinc-900">

                                        #000000

                                    </p>

                                    <input type="hidden"
                                           id="selectedVehicleColorId"
                                           name="VehicleColorIds" />
                                </div>

                            </div>

                            <!-- COLOR AREA -->
                            <div class="flex items-center overflow-hidden">

                                <!-- Left Arrow -->
                                <button type="button"
                                        class="flex h-20 w-16 items-center justify-center border-r border-zinc-200 text-2xl font-black text-zinc-500 transition hover:bg-zinc-100 hover:text-black">

                                    ‹

                                </button>

                                <!-- Dynamic Color Circles -->
                                <div id="colorContainer"
                                     class="flex flex-1 items-center gap-4 overflow-x-auto px-6 py-5">
                                </div>

                                <!-- Plus Button -->
                                <div class="border-l border-zinc-200">

                                    <button type="button"
                                            class="flex h-20 w-16 items-center justify-center text-3xl font-light text-zinc-500 transition hover:bg-red-50 hover:text-red-600">

                                        +

                                    </button>

                                </div>

                                <!-- Right Arrow -->
                                <button type="button"
                                        class="flex h-20 w-16 items-center justify-center border-l border-zinc-200 text-2xl font-black text-zinc-500 transition hover:bg-zinc-100 hover:text-black">

                                    ›

                                </button>

                            </div>

                        </div>

                    </div>

                    <!-- Disclaimer -->
                    <div class="lg:col-span-2">

                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Disclaimer
                        </label>

                        <textarea asp-for="Disclaimer"
                                  rows="4"
                                  placeholder="Actual unit specifications may vary depending on region and model variant."
                                  class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none transition focus:border-red-500 focus:ring-4 focus:ring-red-100"></textarea>

                    </div>

                </div>

            </section>



            <!-- ================================================== Performance ================================================== -->

            <section class="overflow-hidden rounded-[2rem] bg-white shadow-xl">

                <div class="border-b border-zinc-200 bg-black px-8 py-6">

                    <h2 class="text-3xl font-black text-white">
                        Performance
                    </h2>

                </div>

                <div class="grid gap-5 p-8 md:grid-cols-2">


                    <!-- Engine -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Engine
                        </label>

                        <input asp-for="Engine"
                               type="text"
                               placeholder="1KR-VE 3-cylinder, In-Line, 12-valve DOHC"
                               class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />
                    </div>

                    <!-- TransmissionName -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Transmission
                        </label>

                        <select asp-for="TransmissionTypeId"
                                asp-items="Model.TransmissionTypes"
                                class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100">

                            <option value="">
                                Select Transmission
                            </option>

                        </select>
                    </div>

                    <!-- Drivetrain -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Drivetrain
                        </label>

                        <input asp-for="Drivetrain"
                               type="text"
                               placeholder="Front Wheel Drive (FWD) with Electronic Power Steering"
                               class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />
                    </div>

                    <!-- Chassis -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Chassis
                        </label>

                        <input asp-for="Chassis"
                               type="text"
                               placeholder="Double Wishbone with Stabilizer Bar (Front), Rigid Axle, Leaf Spring (Rear)"
                               class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />
                    </div>

                    <!-- ModeName -->
                    <div class="md:col-span-2">

                        <label class="mb-3 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Drive Modes
                        </label>

                        <div class="flex flex-wrap gap-4 rounded-2xl border border-zinc-200 bg-zinc-50 p-5">

                        @if (Model.DriveModes != null && Model.DriveModes.Any())
                        {
                            @foreach (var driveMode in Model.DriveModes)
                            {
                                <label class="flex items-center gap-2">
                                    <input type="checkbox"
                                           name="DriveModeIds"
                                           value="@driveMode.Value" />

                                    <span>@driveMode.Text</span>
                                </label>
                            }
                        }
                        else
                        {
                            <div class="flex w-full justify-center py-4">
                                <span class="text-sm italic text-zinc-400">
                                    No data yet
                                </span>
                            </div>
                        }
                        </div>

                    </div>

                </div>

            </section>



            <!-- ================================================== Technical Specifications ================================================== -->

            <section class="overflow-hidden rounded-[2rem] bg-white shadow-xl">

                <div class="border-b border-zinc-200 bg-black px-8 py-6">

                    <h2 class="text-3xl font-black text-white">
                        Technical Specifications
                    </h2>

                </div>

                <div class="grid gap-5 p-8 md:grid-cols-2">

                    <!-- Suspension -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Suspension
                        </label>

                        <input asp-for="Suspension" type="text" placeholder="Suspension" class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />
                    </div>

                    <!-- SteeringSystemName -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Steering System
                        </label>

                        <input asp-for="SteeringSystemName" type="text" placeholder="Steering System Name" class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />
                    </div>

                    <!-- SteeringTypeName -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Steering Type
                        </label>

                        <input asp-for="SteeringTypeName" type="text" placeholder="Steering Type Name" class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />
                    </div>

                    <!-- PowerSteeringTypeName -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Power Steering Type
                        </label>

                        <select 
                            asp-for="PowerSteeringTypeId"
							asp-items="Model.PowerSteeringTypes"
                            class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100">

                            <option value="">Select Power Steering Type</option>

                        </select>
                    </div>

                    <!-- Front Brake -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Front Brake
                        </label>

                        <select asp-for="FrontBrakeTypeId"
                                asp-items="Model.FrontBrakeTypes"
                                class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100">

                            <option value="">
                                Select Front Brake Type
                            </option>

                        </select>
                    </div>

                    <!-- Rear Brake -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Rear Brake
                        </label>

                        <select asp-for="RearBrakeTypeId"
                                asp-items="Model.RearBrakeTypes"
                                class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100">

                            <option value="">
                                Select Rear Brake Type
                            </option>

                        </select>
                    </div>

                    <!-- MinimumTurningRadius -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Minimum Turning Radius
                        </label>

                        <input asp-for="MinimumTurningRadius"
                               type="number"
                               step="0.01"
                               placeholder="Minimum Turning Radius"
                               class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />
                    </div>

                    <!-- BatteryName -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Battery Name
                        </label>

                        <select asp-for="BatteryTypeId"
                                asp-items="Model.BatteryTypes"
                                class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100">

                            <option value="">Select Battery Type</option>

                        </select>
                    </div>
                </div>

            </section>



            <!-- ================================================== Dimensions & Capacity ================================================== -->

            <section class="overflow-hidden rounded-[2rem] bg-white shadow-xl">

                <div class="border-b border-zinc-200 bg-black px-8 py-6">

                    <h2 class="text-3xl font-black text-white">
                        Dimensions & Capacity
                    </h2>

                </div>

                <div class="grid gap-5 p-8 md:grid-cols-3">

                    <!-- DimensionX -->
                    <div>

                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Width
                        </label>

                        <input asp-for="DimensionX"
                               type="number"
                               step="0.01"
                               class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />

                    </div>

                    <!-- DimensionY-->
                    <div>

                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Height
                        </label>

                        <input asp-for="DimensionY"
                               type="number"
                               step="0.01"
                               class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />
                    </div>

                    <!-- DimensionZ -->
                    <div>

                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Length
                        </label>

                        <input asp-for="DimensionZ"
                               type="number"
                               step="0.01"
                               class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />
                    </div>

                    <!-- GroundClearance -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Ground Clearance
                        </label>

                        <input asp-for="GroundClearance"
                               type="number"
                               step="0.01"
                               placeholder="198.50"
                               class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />
                    </div>

                    <!-- SeatingCapacity -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Seating Capacity
                        </label>

                        <input asp-for="SeatingCapacity"
                               type="number"
                               placeholder="7"
                               class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />
                    </div>

                    <!-- PayloadCapacity -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Payload Capacity
                        </label>

                        <input asp-for="PayloadCapacity"
                               type="number"
                               step="0.01"
                               class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />
                    </div>

                    <!-- FuelCapacity -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Fuel Capacity (Liters)
                        </label>

                        <input asp-for="FuelCapacity"
                               type="number"
                               step="0.01"
                               placeholder="55.00"
                               class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100" />
                    </div>

                </div>

            </section>



            <!-- ================================================== Exterior Features ================================================== -->

            <section class="overflow-hidden rounded-[2rem] bg-white shadow-xl">

                <div class="border-b border-zinc-200 bg-black px-8 py-6">

                    <h2 class="text-3xl font-black text-white">
                        Exterior Features
                    </h2>

                </div>

                <div class="grid gap-5 p-8">

                    <!-- Exterior -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Exterior Features
                        </label>

                        <textarea asp-for="Exterior"
                                  rows="4"
                                  placeholder="Two-tone body color, LED Headlamps"
                                  class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100"></textarea>
                    </div>

                    <!-- TireDiskWheel -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Tire Disk Wheel
                        </label>

                        <textarea asp-for="TireDiskWheel"
                                  rows="4"
                                  placeholder="195R14C With Foldable Bench Seats"
                                  class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100"></textarea>
                    </div>
                </div>

            </section>



            <!-- ================================================== Interior Features ================================================== -->

            <section class="overflow-hidden rounded-[2rem] bg-white shadow-xl">

                <div class="border-b border-zinc-200 bg-black px-8 py-6">

                    <h2 class="text-3xl font-black text-white">
                        Interior Features
                    </h2>

                </div>

                <div class="grid gap-5 p-8 md:grid-cols-2">

                    <!-- Interior -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Interior
                        </label>

                        <textarea asp-for="Interior"
                                  rows="3" placeholder="Interior" 
                                  class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100"></textarea>
                    </div>

                    <!-- MeterCluster -->
                    <div>
                        <label class="w-full mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Meter Cluster
                        </label>

                        <textarea asp-for="MeterCluster"
                                  rows="3" placeholder="Meter Cluster" 
                                  class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100"></textarea>
                    </div>

                    <!-- MultiInfoDisplay -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Multi-Info Display
                        </label>

                        <textarea asp-for="MultiInfoDisplay" 
                                  rows="3" placeholder="Multi Info Display"
                                  class="w-full rounded-2xl border border-zinc-300 bg-zinc-50 px-5 py-4 outline-none focus:border-red-500 focus:ring-4 focus:ring-red-100"></textarea>
                    </div>

                    <!-- Audio -->
                    <div>
                        <label class="mb-2 block text-sm font-bold uppercase tracking-wide text-zinc-500">
                            Audio
                        </label>

                        <textarea asp-for="Audio" 
                                  rows="3" placeholder="Audio" 
