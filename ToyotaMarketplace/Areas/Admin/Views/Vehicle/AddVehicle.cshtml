</div>

@section Scripts {

    <script>

        // All colors from controller
        const vehicleColors =
        @Html.Raw(JsonSerializer.Serialize((object)ViewBag.VehicleColorsData));

        // Elements
        const colorCategoryDropdown =
            document.getElementById("colorCategoryDropdown");

        const colorContainer =
            document.getElementById("colorContainer");

        const selectedColorName =
            document.getElementById("selectedColorName");

        const selectedColorHex =
            document.getElementById("selectedColorHex");



        // =======================  Render Colors =======================

        function renderColors(categoryId)
        {
            // Clear existing circles
            colorContainer.innerHTML = "";

            // Filter colors by category
            const filteredColors = vehicleColors.filter(color =>
                color.VehicleColorCategoryId == categoryId
            );

            // Generate circles
            filteredColors.forEach(color =>
            {
                const button = document.createElement("button");

                button.type = "button";

                button.className =
                    "group relative h-14 w-14 rounded-full border-4 border-white shadow-lg transition hover:scale-125";

                // Circle color
                button.style.backgroundColor =
                    color.VehicleColorHexadecimal;

                // Checkmark
                button.innerHTML = `
                    <span class="absolute inset-0 flex items-center justify-center text-white opacity-0 transition group-hover:opacity-100">
                        ✓
                    </span>
                `;

                // When clicked
                button.addEventListener("click", () =>
                {
                    selectedColorName.innerText =
                        color.VehicleColorName;

                    selectedColorHex.innerText =
                        color.VehicleColorHexadecimal;

                    document.getElementById("selectedVehicleColorId").value = color.VehicleColorId;
                });

                // Append
                colorContainer.appendChild(button);
            });
        }



        // ======================= Dropdown Change =======================

        colorCategoryDropdown.addEventListener("change", function ()
        {
            renderColors(this.value);
        });


            // =======================  Vehicle Models Dynamic Dropdown =======================

            // All vehicle models from controller
            const vehicleModels =
            @Html.Raw(JsonSerializer.Serialize((object)ViewBag.VehicleModelsData));

            // Dropdowns
            const vehicleTypeDropdown =
                document.getElementById("vehicleTypeDropdown");

            const vehicleModelDropdown =
                document.getElementById("vehicleModelDropdown");



            // ======================= Render Vehicle Models ======================

            function renderVehicleModels(vehicleTypeId)
            {
                // Clear old options
                vehicleModelDropdown.innerHTML = "";

                // Default option
                const defaultOption = document.createElement("option");

                defaultOption.value = "";

                defaultOption.text =
                    "Select Vehicle Model";

                vehicleModelDropdown.appendChild(defaultOption);



                // Filter models based on vehicle type
                const filteredModels = vehicleModels.filter(model =>
                    model.VehicleTypeId == vehicleTypeId
                );

                // Create options
                filteredModels.forEach(model =>
                {
                    const option = document.createElement("option");

                    option.value =
                        model.VehicleModelId;

                    option.text =
                        model.ModelName;

                    vehicleModelDropdown.appendChild(option);
                });
            }

            vehicleTypeDropdown.addEventListener("change", function ()
            {
                renderVehicleModels(this.value);
            });


    </script>
}