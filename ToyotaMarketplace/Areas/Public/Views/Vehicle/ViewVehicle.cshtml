@model ToyotaMarketplace.Models.Vehicles.Vehicle

@using System.Text.Json

@{
    Layout = "_Layout";

    var images = JsonSerializer.Deserialize<List<string>>(Model.VehicleImg ?? "[]");
    var firstImage = images?.FirstOrDefault();
}

<div class="min-h-screen bg-zinc-100 py-10">

    <div class="mx-auto max-w-7xl px-6">

        <!-- HERO SECTION -->
        <section class="overflow-hidden rounded-3xl bg-white shadow-xl">

            <div class="grid grid-cols-1 lg:grid-cols-2">

                <!-- IMAGE -->
                <div class="relative h-full">

                    <!-- DB: VehicleImg -->
                    <img src="@firstImage"
                         alt="Vehicle Image" 
                         class="h-full w-full object-contain lg:min-h-[500px]" />

                    <!-- Vehicle Number Badge (Top Left) -->
                    <div class="absolute left-6 top-6 flex items-center gap-3 rounded-full bg-black/60 px-4 py-2 text-white backdrop-blur-md">

                        <img src="~/icons/wheel.svg"
                             class="h-5 w-5 invert"
                             alt="wheel icon" />

                        <!-- DB: Wheel -->
                        <span class="text-sm font-bold tracking-widest">
                            4
                        </span>

                    </div>

                    <!-- Overlay Gradient -->
                    <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>

                    <!-- Badges (Top Right) -->
                    <div class="absolute right-6 top-6 flex gap-3">

                        @* <span class="rounded-full bg-emerald-500 px-4 py-2 text-sm font-semibold text-white shadow-lg"> *@
                        @*     Hybrid *@
                        @* </span> *@

                        @* <span class="rounded-full bg-sky-500 px-4 py-2 text-sm font-semibold text-white shadow-lg"> *@
                        @*     Electric *@
                        @* </span> *@

                    </div>

                </div>

                <!-- DETAILS -->
                <div class="flex flex-col justify-center p-10 lg:p-14">

                    <!-- VEHICLE TYPE + WARNING -->
                    <div class="mb-4 flex w-fit items-center gap-2">

                        <!-- VehicleTypeName -->
                        <span class="rounded-full bg-red-100 px-4 py-1 text-sm font-semibold text-red-600">
                            @Model.VehicleModel?.VehicleType?.VehicleTypeName
                        </span>

                        <!-- Warning Icon -->
                        <div class="relative group">

                            <img src="~/icons/warning.svg"
                                 alt="Disclaimer"
                                 class="h-5 w-5 cursor-pointer text-yellow-500 transition hover:scale-110" />

                            <!-- Tooltip (trim label): DB: Disclaimer -->
                            <div class="absolute left-1/2 top-7 z-50 hidden w-64 -translate-x-1/2 rounded-lg bg-zinc-900 px-3 py-2 text-xs text-white shadow-lg group-hover:block">

                                @Model.VehicleSpec?.Disclaimer

                            </div>

                        </div>

                    </div>

                    <!-- DB: ModelName -->
                    <h1 class="text-5xl font-black tracking-tight text-zinc-900">
                        @Model.VehicleModel?.ModelName
                    </h1>

                    <!-- DB: VehicleName -->
                    <p class="mt-2 text-lg font-medium text-zinc-500">
                        @Model.VehicleName
                    </p>

                    <!-- DB: VehicleColorName via VehicleColorId in Vehicles table -->
                    <div class="mt-4 flex items-center gap-3">

                        <span class="text-sm font-semibold text-zinc-700">
                            @Model.VehicleColor?.VehicleColorName
                        </span>
                        
                        
                        <!-- DB: VehicleColorName -->
                        <!--
                        <button class="h-6 w-6 rounded-full bg-black ring-2 ring-transparent transition hover:scale-110 hover:ring-zinc-400"></button>
                        <button class="h-6 w-6 rounded-full bg-white border transition hover:scale-110 hover:ring-2 hover:ring-zinc-400"></button>
                        <button class="h-6 w-6 rounded-full bg-red-500 transition hover:scale-110 hover:ring-2 hover:ring-zinc-400"></button>
                        <button class="h-6 w-6 rounded-full bg-blue-500 transition hover:scale-110 hover:ring-2 hover:ring-zinc-400"></button>
                        -->
                    </div>

                    <!-- DB: ModelNote -->
                    <p class="mt-5 text-lg leading-relaxed text-zinc-600">
                        @Model.VehicleSpec.ModelNote
                    </p>

                    
                    <div class="mt-10">

                        <p class="text-sm uppercase tracking-[0.3em] text-zinc-400">
                            Starting Price
                        </p>

                        <!-- DB: VehicleSRP. -->
                        <h2 class="mt-2 text-4xl font-extrabold text-green-600">
                            ₱ @Model.VehicleSRP?.ToString("N0")
                        </h2>

                    </div>

                    
                    <p class="mt-6 text-xs leading-relaxed text-zinc-400">
                        ** This photo is a different spec variant, actual unit may vary.
                    </p>

                </div>

            </div>

        </section>

        <!-- CONTENT SECTIONS -->
        <div class="mt-10 space-y-8">

            <!-- ================================================== Performance ================================================== -->

            <section class="overflow-hidden rounded-[2rem] bg-white shadow-xl">

                <!-- Accordion Header -->
                <button type="button"
                        onclick="toggleAccordion('performanceAccordion', 'performanceIcon')"
                        class="flex w-full items-center justify-between bg-black px-8 py-6 text-left transition hover:bg-zinc-900">

                    <div>

                        <h2 class="text-3xl font-black text-white">
                            Performance
                        </h2>

                        <!--
                            <div class="mt-3 h-1.5 w-48 rounded-full bg-white"></div>
                        -->

                    </div>

                    <!-- Rotating SVG -->
                    <svg id="performanceIcon"
                         xmlns="http://www.w3.org/2000/svg"
                         fill="none"
                         viewBox="0 0 24 24"
                         stroke-width="2.5"
                         stroke="currentColor"
                         class="h-7 w-7 text-white transition duration-300">

                        <path stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M19.5 8.25L12 15.75 4.5 8.25" />

                    </svg>

                </button>

                <!-- Accordion Content -->
                <div id="performanceAccordion"
                     class="max-h-0 overflow-hidden bg-white transition-all duration-500">

                    <div class="grid gap-5 p-8 md:grid-cols-2">

                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">
                                Engine
                            </p>

                            <!-- DB: Engine -->
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">
                                @Model.VehicleSpec?.VehiclePerformance?.Engine
                            </h3>
                        </div>

                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">

                            <p class="text-sm uppercase tracking-wide text-zinc-400">
                                Transmission
                            </p>

                            <!-- DB: TransmissionName -->
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">
                                @Model.VehicleSpec?.VehiclePerformance?.TransmissionType?.TransmissionName
                            </h3>
                        </div>

                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">
                                Drivetrain
                            </p>

                            <!-- DB: Drivetrain -->
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">
                                @Model.VehicleSpec?.VehiclePerformance?.Drivetrain
                            </h3>
                        </div>

                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">
                                @Model.VehicleSpec?.VehiclePerformance?.Chassis
                            </p>

                            <!-- DB: Chassis -->
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">
                                Chassis: Turbo Charged, 3 Cylinders, Inline, 12-Valve DOHC VVT-i
                            </h3>
                        </div>

                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5 md:col-span-2">

                            <p class="text-sm uppercase tracking-wide text-zinc-400">
                                Drive Modes
                            </p>

                            <!-- DB: ModeName -->

                            <div class="mt-3 flex flex-wrap gap-3">
                                @foreach (var mode in Model.VehicleSpec.VehiclePerformance.VehiclePerformanceDriveModes)
                                {
                                    string badgeClass = mode.DriveMode.ModeName switch
                                    {
                                        "Eco" => "bg-emerald-100 text-emerald-700",
                                        "Normal" => "bg-zinc-200 text-zinc-700",
                                        "Sport" => "bg-orange-100 text-orange-700",
                                        "EV" => "bg-sky-100 text-sky-700",
                                        _ => "bg-gray-100 text-gray-700"
                                    };

                                    <span class="rounded-full px-4 py-2 text-sm font-semibold @badgeClass">
                                        @mode.DriveMode.ModeName
                                    </span>
                                }
                            </div>

                            <!--
                            <div class="mt-3 flex flex-wrap gap-3">

                                <span class="rounded-full bg-emerald-100 px-4 py-2 text-sm font-semibold text-emerald-700">
                                    DriveMode: Eco
                                </span>

                                <span class="rounded-full bg-zinc-200 px-4 py-2 text-sm font-semibold text-zinc-700">
                                    DriveMode: Normal
                                </span>

                                <span class="rounded-full bg-orange-100 px-4 py-2 text-sm font-semibold text-orange-700">
                                    DriveMode: Sport
                                </span>

                                <span class="rounded-full bg-sky-100 px-4 py-2 text-sm font-semibold text-sky-700">
                                    DriveMode: EV
                                </span>

                            </div>
                            -->

                        </div>

                    </div>

                </div>

            </section>



            <!-- ================================================== Technical Specifications ================================================== -->

            <section class="overflow-hidden rounded-[2rem] bg-white shadow-xl">

                <!-- Header -->
                <button type="button"
                        onclick="toggleAccordion('technicalContent', 'technicalIcon')"
                        class="flex w-full items-center justify-between bg-black px-8 py-6 text-left transition hover:bg-zinc-900">

                    <div>
                        <h2 class="text-3xl font-black text-white">
                            Technical Specifications
                        </h2>
                    </div>

                    <!-- ICON -->
                    <img id="technicalIcon"
                         src="~/icons/down-arrow.svg"
                         class="h-7 w-7 invert transition-transform duration-300"
                         alt="toggle icon" />

                </button>

                <!-- Content -->
                <div id="technicalContent"
                     class="max-h-0 overflow-hidden bg-white transition-all duration-500">

                    <div class="grid gap-5 p-8 md:grid-cols-2">

                        <!-- DB: Suspension -->
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Suspension</p>
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">@Model.VehicleSpec?.VehicleTechnical?.Suspension</h3>
                        </div>

                        <!-- DB: SteeringSystemName -->
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Steering System</p>
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">@Model.VehicleSpec?.VehicleTechnical?.SteeringSystem?.SteeringSystemName</h3>
                        </div>

                        <!-- DB: SteeringTypeName -->
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Steering Type</p>
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">@Model.VehicleSpec?.VehicleTechnical?.SteeringType?.SteeringTypeName</h3>
                        </div>

                        <!-- DB: PowerSteeringTypeName -->
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Power Steering</p>
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">@Model.VehicleSpec?.VehicleTechnical?.PowerSteeringType?.PowerSteeringTypeName</h3>
                        </div>

                        <!-- DB: FrontBrake -->
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Front Brake</p>
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">@Model.VehicleSpec?.VehicleTechnical?.FrontBrakeType?.FrontBrakeName</h3>
                        </div>

                        <!-- DB: RearBrake -->
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Rear Brake</p>
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">@Model.VehicleSpec?.VehicleTechnical?.RearBrakeType?.RearBrakeName</h3>
                        </div>

                        <!-- DB: AntiLockBrakeSystem -->
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">ABS</p>
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">@Model.VehicleSpec?.VehicleTechnical?.AntiLockBrakeSystem</h3>
                        </div>

                        <!-- DB: MinimumTurningRadius -->
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Turning Radius</p>
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">@Model.VehicleSpec?.VehicleTechnical?.MinimumTurningRadius</h3>
                        </div>

                        <!-- DB: BatteryName -->
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5 md:col-span-2">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Battery</p>
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">@Model.VehicleSpec?.VehicleTechnical?.BatteryType?.BatteryName</h3>
                        </div>

                    </div>

                </div>

            </section>



            <!-- ================================================== Dimensions & Capacity ================================================== -->

            <section class="overflow-hidden rounded-[2rem] bg-white shadow-xl">

                <!-- Header -->
                <button type="button"
                        onclick="toggleAccordion('dimensionsContent', 'dimensionsIcon')"
                        class="flex w-full items-center justify-between bg-black px-8 py-6 text-left transition hover:bg-zinc-900">

                    <div>
                        <h2 class="text-3xl font-black text-white">
                            Dimensions & Capacity
                        </h2>
                    </div>

                    <img id="dimensionsIcon"
                         src="~/icons/down-arrow.svg"
                         class="h-7 w-7 invert transition-transform duration-300"
                         alt="toggle icon" />
                </button>

                <!-- Content -->
                <div id="dimensionsContent"
                     class="max-h-0 overflow-hidden bg-white transition-all duration-500">

                    <div class="grid gap-5 p-8 md:grid-cols-2">

                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Dimension</p>

                            <!-- DB: DimensionX, DimensionY, Dimension Z -->
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">
                                @Model.VehicleSpec?.VehicleDimensionFuel?.DimensionZ mm (L)
                                ×
                                @Model.VehicleSpec?.VehicleDimensionFuel?.DimensionX mm (W)
                                ×
                                @Model.VehicleSpec?.VehicleDimensionFuel?.DimensionY mm (H)
                            </h3>
                        </div>


                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Ground Clearance</p>

                            <!-- DB: GroundClearance -->
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">
                                @Model.VehicleSpec?.VehicleDimensionFuel?.GroundClearance mm
                            </h3>
                        </div>

                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Seating Capacity</p>

                            <!-- DB: SeatingCapacity -->
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">
                                @Model.VehicleSpec?.VehicleDimensionFuel?.SeatingCapacity Pax
                            </h3>
                        </div>

                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Payload Capacity</p>

                            <!-- DB: PayloadCapacity -->
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">
                                @Model.VehicleSpec?.VehicleDimensionFuel?.PayloadCapacity KG
                            </h3>
                        </div>

                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5 md:col-span-2">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Fuel Capacity</p>

                            <!-- DB: FuelCapacity -->
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">
                                @Model.VehicleSpec?.VehicleDimensionFuel?.FuelCapacity L
                            </h3>
                        </div>

                    </div>

                </div>

            </section>



            <!-- ================================================== Exterior Features ================================================== -->

            <section class="overflow-hidden rounded-[2rem] bg-white shadow-xl">

                <!-- Header -->
                <button type="button"
                        onclick="toggleAccordion('exteriorContent', 'exteriorIcon')"
                        class="flex w-full items-center justify-between bg-black px-8 py-6 text-left transition hover:bg-zinc-900">

                    <div>
                        <h2 class="text-3xl font-black text-white">
                            Exterior Features
                        </h2>
                    </div>

                    <img id="exteriorIcon"
                         src="~/icons/down-arrow.svg"
                         class="h-7 w-7 invert transition-transform duration-300"
                         alt="toggle icon" />
                </button>

                <!-- Content -->
                <div id="exteriorContent"
                     class="max-h-0 overflow-hidden bg-white transition-all duration-500">

                    <div class="grid gap-5 p-8 md:grid-cols-2">

                        <!-- DB: Exterior -->
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5 md:col-span-2">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Exterior</p>
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">
                                @Model.VehicleSpec?.VehicleFeature?.Exterior
                            </h3>
                        </div>

                        <!-- DB: TireDiskWheel -->
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5 md:col-span-2">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Tire & Wheel</p>
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">
                                @Model.VehicleSpec?.VehicleFeature?.TireDiskWheel
                            </h3>
                        </div>

                    </div>

                </div>

            </section>



            <!-- ================================================== Interior Features ================================================== -->

            <section class="overflow-hidden rounded-[2rem] bg-white shadow-xl">

                <!-- Header -->
                <button type="button"
                        onclick="toggleAccordion('interiorContent', 'interiorIcon')"
                        class="flex w-full items-center justify-between bg-black px-8 py-6 text-left transition hover:bg-zinc-900">

                    <div>
                        <h2 class="text-3xl font-black text-white">
                            Interior Features
                        </h2>
                    </div>

                    <img id="interiorIcon"
                         src="~/icons/down-arrow.svg"
                         class="h-7 w-7 invert transition-transform duration-300"
                         alt="toggle icon" />
                </button>

                <!-- Content -->
                <div id="interiorContent"
                     class="max-h-0 overflow-hidden bg-white transition-all duration-500">

                    <div class="grid gap-5 p-8 md:grid-cols-2">

                        <!-- DB: Interior -->
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5 md:col-span-2">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Interior</p>
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">
                                @Model.VehicleSpec?.VehicleFeature?.Interior
                            </h3>
                        </div>

                        <!-- DB: MeterCluster -->
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Meter Cluster</p>
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">
                                @Model.VehicleSpec?.VehicleFeature?.MeterCluster
                            </h3>
                        </div>

                        <!-- DB: MultiInfoDisplay -->
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Multi-Info Display</p>
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">
                                @Model.VehicleSpec?.VehicleFeature?.MultiInfoDisplay
                            </h3>
                        </div>

                        <!-- DB: Audio -->
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Audio System</p>
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">
                                @Model.VehicleSpec?.VehicleFeature?.Audio
                            </h3>
                        </div>

                        <!-- DB: Ignition -->
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Ignition</p>
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">
                                @Model.VehicleSpec?.VehicleFeature?.Ignition
                            </h3>
                        </div>

                        <!-- DB: Function -->
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5 md:col-span-2">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Function</p>
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">
                                @Model.VehicleSpec?.VehicleFeature?.Function
                            </h3>
                        </div>

                    </div>

                </div>
            </section>



            <!-- ================================================== Safety Features ================================================== -->

            <section class="overflow-hidden rounded-[2rem] bg-white shadow-xl">

                <!-- Header -->
                <button type="button"
                        onclick="toggleAccordion('safetyContent', 'safetyIcon')"
                        class="flex w-full items-center justify-between bg-black px-8 py-6 text-left transition hover:bg-zinc-900">

                    <div>
                        <h2 class="text-3xl font-black text-white">
                            Safety Features
                        </h2>
                    </div>

                    <img id="safetyIcon"
                         src="~/icons/down-arrow.svg"
                         class="h-7 w-7 invert transition-transform duration-300"
                         alt="toggle icon" />
                </button>

                <!-- Content -->
                <div id="safetyContent"
                     class="max-h-0 overflow-hidden bg-white transition-all duration-500">

                    <div class="grid gap-5 p-8 md:grid-cols-2">

                        <!-- DB: Safety -->
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5 md:col-span-2">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Safety Suite</p>
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">
                                @Model.VehicleSpec?.VehicleFeature?.Safety
                            </h3>
                        </div>

                        <!-- DB: AntiLockBrakeSystem -->
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5 md:col-span-2">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Brake System</p>
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">
                                @Model.VehicleSpec?.VehicleTechnical?.AntiLockBrakeSystem
                            </h3>
                        </div>

                    </div>

                </div>
            </section>



            <!-- ================================================== Additional Information ================================================== -->

            <section class="overflow-hidden rounded-[2rem] bg-white shadow-xl">

                <!-- Header -->
                <button type="button"
                        onclick="toggleAccordion('additionalContent', 'additionalIcon')"
                        class="flex w-full items-center justify-between bg-black px-8 py-6 text-left transition hover:bg-zinc-900">

                    <div>
                        <h2 class="text-3xl font-black text-white">
                            Additional Information
                        </h2>
                    </div>

                    <img id="additionalIcon"
                         src="~/icons/down-arrow.svg"
                         class="h-7 w-7 invert transition-transform duration-300"
                         alt="toggle icon" />
                </button>

                <!-- Content -->
                <div id="additionalContent"
                     class="max-h-0 overflow-hidden bg-white transition-all duration-500">

                    <div class="grid gap-5 p-8 md:grid-cols-2">


                        <!-- DB: Disclaimer -->
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5 md:col-span-2">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Disclaimer</p>
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">
                                @Model.VehicleSpec?.Disclaimer
                            </h3>
                        </div>

                        <!-- DB: DatePosted -->
                        <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5 md:col-span-2">
                            <p class="text-sm uppercase tracking-wide text-zinc-400">Date Posted</p>
                            <h3 class="mt-1 text-lg font-bold text-zinc-900">
                                @Model.DatePosted.ToString("MMMM dd, yyyy")
                            </h3>
                        </div>

                    </div>

                </div>

            </section>

        </div>

    </div>

</div>

<script>

    function toggleAccordion(contentId, iconId) {

        const content = document.getElementById(contentId);
        const icon = document.getElementById(iconId);

        const isOpen = content.classList.contains('max-h-0');

        if (isOpen) {

            content.classList.remove('max-h-0');
            content.classList.add('max-h-[2000px]');

            icon.classList.remove('rotate-180');

        } else {

            content.classList.add('max-h-0');
            content.classList.remove('max-h-[2000px]');

            icon.classList.add('rotate-180');

        }
    }

</script>