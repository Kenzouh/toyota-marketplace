@model ToyotaMarketplace.Models.ViewModels.Public.Login.LoginViewModel

@{
	Layout = "~/Areas/Public/Views/Shared/_Layout.cshtml";
}

<div class="min-h-screen flex items-center justify-center ">

    <div class="backdrop-blur-md p-8 rounded-2xl shadow-2xl bg-gradient-to-br from-black via-gray-900 to-red-900 w-full max-w-md border border-red-500/30">

        <!-- Title -->
        <h2 class="text-3xl font-bold text-center text-white mb-6">
            Login
        </h2>

        <!-- Form -->
        <form asp-action="Index" method="post" class="space-y-5">

            @Html.AntiForgeryToken()

            <!-- Validation Summary -->
            <div asp-validation-summary="ModelOnly" class="text-red-400 text-sm text-center"></div>


            <!-- Gmail -->
            <div>
                <label class="block text-sm text-gray-300 mb-1">Gmail *</label>

                <input asp-for="Email"
                        placeholder="myemail@gmail.com"
                        class="w-full px-4 py-2 rounded-xl bg-black/40 text-white border border-gray-600
                        focus:outline-none focus:ring-1 focus:ring-white focus:border-white
                        transition input-validation-error:border-red-500" />

                <span asp-validation-for="Email" class="text-red-400 text-sm"></span>
            </div>

            <!-- Password -->
            <div>
                <label class="block text-sm text-gray-300 mb-1">Password *</label>

                <input asp-for="Password" type="password"
                       placeholder="Enter your password"
                       class="w-full px-4 py-2 rounded-xl bg-black/40 text-white border border-gray-600 focus:outline-none 
                        focus:ring-1 focus:ring-white focus:border-white transition" />

                <span asp-validation-for="Password" class="text-red-400 text-sm"></span>
            </div>

            <!-- Button -->
            <button type="submit"
                    class="w-full py-2 rounded-xl bg-red-600 hover:bg-red-700 text-white font-semibold transition duration-300 shadow-lg">
                Sign In
            </button>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}