<div class="w-72 bg-white p-5 rounded-lg shadow-md">

    <!-- Title -->
    <h2 class="text-xl font-bold mb-4">Filters</h2>

    <!-- Vehicle Type -->
    <div class="mb-6">
        <h3 class="font-semibold mb-2">Vehicle Type</h3>
        <div class="flex flex-wrap gap-2">
            <button class="px-3 py-1 bg-gray-200 rounded">SUV</button>
            <button class="px-3 py-1 bg-gray-200 rounded">Sedan</button>
            <button class="px-3 py-1 bg-gray-200 rounded">Truck</button>
            <button class="px-3 py-1 bg-gray-200 rounded">Van</button>
        </div>
    </div>

    <!-- Price Range -->
    <div class="mb-6">
        <h3 class="font-semibold mb-2">Price Range (MSRP)</h3>

        <input type="range" min="0" max="5000000" value="1000000" class="w-full" id="priceRange">

        <div class="flex justify-between mt-2 gap-2">
            <input type="number" id="minPrice" class="w-1/2 border p-1 rounded" placeholder="Min PHP">
            <input type="number" id="maxPrice" class="w-1/2 border p-1 rounded" placeholder="Max PHP">
        </div>
    </div>

    <!-- Seating Capacity -->
    <div>
        <h3 class="font-semibold mb-2">Seating Capacity</h3>
        <div class="grid grid-cols-4 gap-2">
            @foreach (var seat in new[] { 2, 3, 4, 5, 6, 7, 8, 10, 12, 14, 15, 29 })
            {
                <button class="px-2 py-1 bg-gray-200 rounded">@seat</button>
            }
        </div>
    </div>

</div>