@model ToyotaMarketplace.Models.ViewModels.Public.HomeViewModel

<div class="w-72 bg-white p-5 rounded-lg shadow-md">

    <!-- Title -->
    <h2 class="text-xl font-bold mb-4">Filters</h2>

    <!-- Vehicle Type -->
    <div class="mb-6">
        <h3 class="font-semibold mb-2">Vehicle Type</h3>

        <div class="flex flex-wrap gap-2">

            @foreach (var type in Model.VehicleTypes)
            {
                bool isActive =
                Context.Request.Query["vehicleTypeId"] == type.VehicleTypeId.ToString();

                if (isActive)
                {
                    <span class="px-3 py-1 rounded bg-red-500 text-white cursor-default">
                        @type.VehicleTypeName
                    </span>
                }
                else
                {
                    <a asp-action="Index"
                       asp-controller="Home"
                       asp-route-vehicleTypeId="@type.VehicleTypeId"
                       asp-route-seatingCapacity="@Context.Request.Query["seatingCapacity"]"
                       asp-route-minPrice="@Context.Request.Query["minPrice"]"
                       asp-route-maxPrice="@Context.Request.Query["maxPrice"]"
                       class="px-3 py-1 rounded bg-gray-200 hover:bg-red-200 transition">

                        @type.VehicleTypeName

                    </a>
                }
            }

        </div>
    </div>

    <!-- Price Range -->
    <form asp-action="Index" method="get">

        <h3 class="font-semibold mb-2">
            Price Range (SRP)
        </h3>

        <div class="flex justify-between mt-2 gap-2">

            <input type="number"
                   name="minPrice"
                   placeholder="Min PHP"
                   class="w-1/2 border p-1 rounded" />

            <input type="number"
                   name="maxPrice"
                   placeholder="Max PHP"
                   class="w-1/2 border p-1 rounded" />

        </div>

        <button type="submit"
                class="mt-3 w-full bg-red-500 text-white py-2 rounded">

            Apply

        </button>

    </form>

    <!-- Seating Capacity -->
    <div>
        <h3 class="font-semibold mb-2">Seating Capacity</h3>
        <div class="grid grid-cols-4 gap-2">

            @foreach (var seat in Model.SeatingCapacities)
            {
                bool isActive =
                Context.Request.Query["seatingCapacity"] == seat.ToString();

                if (isActive)
                {
                    <span class="px-2 py-1 rounded bg-red-500 text-white text-center cursor-default">
                        @seat
                    </span>
                }
                else
                {
                    <a asp-action="Index"
                       asp-controller="Home"
                       asp-route-seatingCapacity="@seat"
                       asp-route-vehicleTypeId="@Context.Request.Query["vehicleTypeId"]"
                       asp-route-minPrice="@Context.Request.Query["minPrice"]"
                       asp-route-maxPrice="@Context.Request.Query["maxPrice"]"
                       class="px-2 py-1 rounded text-center bg-gray-200 hover:bg-red-200 transition">

                        @seat

                    </a>
                }
            }
        </div>

        <div class="mt-6">
            <a asp-action="Index"
               asp-controller="Home"
               class="block w-full text-center bg-gray-300 text-gray-800 py-2 rounded hover:bg-gray-400 transition">

                Clear Filters

            </a>
        </div>
    </div>

</div>