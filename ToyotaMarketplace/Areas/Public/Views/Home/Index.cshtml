@model ToyotaMarketplace.Models.ViewModels.Public.HomeViewModel

@{
    Layout = "~/Areas/Public/Views/Shared/_Layout.cshtml";
}

<div class="flex gap-6">

    <!-- Left part: Sidebar -->
    <partial name="_SidebarFilters" model="Model" />

    <!-- Right part: Main Content -->
    <div class="flex-1">

        <!-- Top Controls -->
        <div class="flex justify-between items-center mb-6">

            <div>
                @if (User.Identity != null && User.Identity.IsAuthenticated)
                {
                    <!-- Add Vehicle -->
                    <a asp-area="Admin" asp-controller="Vehicle" asp-action="AddVehicle"
                    class="bg-red-500 text-white px-4 py-2 rounded hover:bg-red-700">
                        + Add Vehicle
                    </a>
                }
            </div>

            <!-- Sort Dropdown -->
            <div class="flex">

                <h1 class="mr-4">Sort By:</h1>

                <form method="get">

                    <!-- Keep existing filters -->
                    <input type="hidden"
                           name="vehicleTypeId"
                           value="@Context.Request.Query["vehicleTypeId"]" />

                    <input type="hidden"
                           name="seatingCapacity"
                           value="@Context.Request.Query["seatingCapacity"]" />

                    <input type="hidden"
                           name="minPrice"
                           value="@Context.Request.Query["minPrice"]" />

                    <input type="hidden"
                           name="maxPrice"
                           value="@Context.Request.Query["maxPrice"]" />

                    <select name="sortBy"
                            class="border-2 rounded"
                            onchange="this.form.submit()">

                        <option value="">Default</option>

                        <option value="name"
                                selected="@(Context.Request.Query["sortBy"] == "name")">
                            Vehicle Name (A-Z)
                        </option>

                        <option value="price"
                                selected="@(Context.Request.Query["sortBy"] == "price")">
                            Starting Price (Lowest)
                        </option>

                    </select>

                </form>

            </div>
        </div>

        <!-- Vehicle Cards Section -->
        <div class="space-y-6">

            <!-- Vehicle Cards Section -->
            <div class="space-y-6">

                @if (Model?.Vehicles == null || !Model.Vehicles.Any())
                {
                    <div class="text-center">
                        <h2 class="text-2xl font-bold text-gray-500">
                            No vehicles available :(
                        </h2>
                    </div>
                }
                else
                {
                    <!-- Cards Grid -->
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-6">

                        @foreach (var vehicle in Model.Vehicles)
                        {
                            var images = System.Text.Json.JsonSerializer.Deserialize<List<string>>(vehicle.VehicleImg ?? "[]");
                            var firstImage = images?.FirstOrDefault();

                            <!-- Card -->
                            <div class="bg-white rounded-lg shadow p-4">

                                <!-- Logos Row -->
                                <div class="flex justify-end items-center gap-2 bg-white rounded-lg">

                                    @if (vehicle.VehicleModel?.VehicleType?.VehicleTypeName == "Electrified")
                                    {
                                        <img src="~/images/logos/HEV.png"
                                             class="h-4 object-contain" />
                                    }

                                    @if (vehicle.VehicleModel?.VehicleType?.VehicleTypeName == "Gazoo Racing")
                                    {
                                        <img src="~/images/logos/Gazoo Racing.png"
                                             class="h-4 object-contain" />
                                    }

                                </div>

                                <!-- Vehicle Image -->
                                <img src="@firstImage"
                                     class="w-full h-40 object-contain rounded mb-3" />

                                <hr />

                                <!-- Vehicle Info -->
                                <h3 class="text-lg font-bold">
                                    @vehicle.VehicleModel?.ModelName
                                </h3>

                                <h4 class="text-gray-400 mb-3">
                                    Starts at ₱@(vehicle.VehicleSRP?.ToString("N0"))
                                </h4>

                                <div class="flex justify-between">

                                    <a asp-area="Public"
                                       asp-controller="Vehicle"
                                       asp-action="ViewVehicle"
                                       asp-route-id="@vehicle.VehicleId"
                                       class="text-blue-500">
                                        View
                                    </a>

                                    @if (User.Identity != null && User.Identity.IsAuthenticated)
                                    {
                                        <a asp-area="Admin"
                                           asp-controller="Vehicle"
                                           asp-action="EditVehicle"
                                           asp-route-id="@vehicle.VehicleId"
                                           class="text-green-500">
                                            Edit
                                        </a>
                                    }

                                </div>

                            </div>
                        }

                    </div>
                }

            </div>

        </div>

    </div>

</div>

<h1 class="text-red-500 text-4xl font-bold">
    Working test
</h1>

@section Scripts {
    <script>
        const range = document.getElementById("priceRange");
        const minInput = document.getElementById("minPrice");
        const maxInput = document.getElementById("maxPrice");

        range.addEventListener("input", () => {
            minInput.value = range.value;
        });

        minInput.addEventListener("input", () => {
            range.value = minInput.value;
        });
    </script>
}